// **************************************************************************
// TypeAdapterGenerator
// **************************************************************************

class EstabelecimentoAdapter extends TypeAdapter<Estabelecimento> {
  @override
  final int typeId = 1;

  @override
  Estabelecimento read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return Estabelecimento(
      id: fields[0] as String,
      idOwner: fields[1] as String,
      name: fields[2] as String,
    );
  }

  @override
  void write(BinaryWriter writer, Estabelecimento obj) {
    writer
      ..writeByte(3)
      ..writeByte(0)
      ..write(obj.id)
      ..writeByte(1)
      ..write(obj.idOwner)
      ..writeByte(2)
      ..write(obj.name);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is EstabelecimentoAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}
