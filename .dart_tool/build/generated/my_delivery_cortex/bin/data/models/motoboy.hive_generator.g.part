// **************************************************************************
// TypeAdapterGenerator
// **************************************************************************

class MotoboyAdapter extends TypeAdapter<Motoboy> {
  @override
  final int typeId = 3;

  @override
  Motoboy read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return Motoboy(
      id: fields[0] as String,
      idUsr: fields[1] as String,
      placa: fields[2] as String,
      motoCor: fields[3] as String,
    );
  }

  @override
  void write(BinaryWriter writer, Motoboy obj) {
    writer
      ..writeByte(4)
      ..writeByte(0)
      ..write(obj.id)
      ..writeByte(1)
      ..write(obj.idUsr)
      ..writeByte(2)
      ..write(obj.placa)
      ..writeByte(3)
      ..write(obj.motoCor);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is MotoboyAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}
